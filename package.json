{
  "name": "salta",
  "version": "0.1.0",
  "private": true,
  "description": "A playable digital reconstruction of Salta, the 1899 board game",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "watch": "vitest",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "marked": "^18.0.9",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
